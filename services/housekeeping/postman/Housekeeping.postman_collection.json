    {
      "name": "— Suppression, recherche —",
      "item": [
        {
          "name": "10. Créer puis SUPPRIMER un service assigné",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/housekeeping/services/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "housekeeping",
                "services"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chambre_id\": \"4\",\n  \"agent_id\": \"7\",\n  \"type\": \"DEPART\",\n  \"date_prevue\": \"2026-11-20\",\n  \"description\": \"À supprimer\",\n  \"priorite\": \"BASSE\"\n}"
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('service_a_supprimer', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Supprimer le service (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/housekeeping/services/{{service_a_supprimer}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "housekeeping",
                "services",
                "{{service_a_supprimer}}"
              ]
            }
          },
          "description": "Autorisé seulement si le service est « assigné » ; sinon 409.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "12. Recherche libre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/housekeeping/services/?q=Draps",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "housekeeping",
                "services",
                "?q=Draps"
              ]
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "— Demandes de nettoyage (client) —",
      "item": [
        {
          "name": "13. Client : demander un nettoyage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/housekeeping/demandes/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "housekeeping",
                "demandes"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_client}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chambre_id\": \"1\",\n  \"description\": \"Serviettes propres\",\n  \"priorite\": \"NORMALE\"\n}"
            }
          },
          "description": "Jeton CLIENT (variable token_client). 201 si la chambre est occupée ; 409 sinon.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('demande_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
