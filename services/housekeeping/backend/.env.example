# Exemple pour lancer housekeeping hors Docker (IntelliJ / terminal).
# Copiez en .env (ignoré par git) ou injectez-le via le plugin EnvFile.

POSTGRES_DB=riadmanager
POSTGRES_USER=riad
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SCHEMA=housekeeping

JWT_SECRET=change_me_commun_a_tous_les_services
JWT_ALGORITHM=HS256
INTERNAL_API_TOKEN=change_me_interne

# Faux services (python dev/mock_services.py) ou vrais services
CHAMBRES_API_URL=http://localhost:9000
USERS_API_URL=http://localhost:9000
CHAMBRES_ETAT_FIELD=etat

DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173
